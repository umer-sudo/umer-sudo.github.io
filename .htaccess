# Apache / GoDaddy cPanel rules for the static export (npm run build:static → ./out).
#
# Only needed on a plain file host. Netlify and Vercel read the redirects in
# next.config.ts instead, and neither reads this file — if you change one, change
# the other, the same rule that already applies to netlify.toml and vercel.json.

# --- Redirects from the site this one replaced -------------------------------
# The previous site had five routes. Without these, every link and every search
# result pointing at them 404s and Google discards their history rather than
# transferring it. Sources: the old bundle's own route table.
#   /blogs             → /blog          (renamed)
#   /lp                → /contact       (the old landing page's job)
# /privacy-policy and /terms-of-service have no equivalent yet and are left to
# the 404 deliberately — pointing a legal URL at an unrelated page is worse than
# a missing page.
Redirect 301 /blogs /blog
Redirect 301 /lp /contact

# The three service pages became one, per the approved navigation.
Redirect 301 /services/performance /services
Redirect 301 /services/creators /services
Redirect 301 /services/ai-product /services

# --- Security headers --------------------------------------------------------
# Mirrors netlify.toml and vercel.json.
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set X-Frame-Options "DENY"
  Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
  <FilesMatch "^.*\.(js|css|woff2)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
</IfModule>

ErrorDocument 404 /404.html
